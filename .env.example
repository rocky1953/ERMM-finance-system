# ERMM 財務模組 — 環境變數範本
# 複製為 .env 後填入真實值

# ====== 資料庫（必填）======
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=ERMM_db

# ====== JWT（必填）======
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_EXPIRES_IN=24h

# ====== Server ======
PORT=3008

# ====== 通知渠道（選填）======
# Email (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Lark Webhook
LARK_WEBHOOK_URL=

# 企業微信 Webhook
WXWORK_WEBHOOK_URL=
